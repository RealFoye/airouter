# Local-only AI Router environment variables.
# Copy to .env and fill with your company AI gateway key.
#
# The current CCH gateway uses one OpenAI-compatible endpoint for all configured
# providers. AI Router keeps provider names for routing metadata, so the same
# gateway key can be assigned to each provider-specific variable.

AIROUTER_DASHSCOPE_API_KEY=
AIROUTER_DEEPSEEK_API_KEY=
AIROUTER_ZHIPU_API_KEY=
AIROUTER_KIMI_API_KEY=
AIROUTER_MINIMAX_API_KEY=
